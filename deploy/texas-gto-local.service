[Unit]
Description=Texas GTO local algorithm service
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/Project/Texas-GTO
ExecStart=%h/Project/Texas-GTO/.venv/bin/python -m texas_analysis
Environment=PYTHONUNBUFFERED=1
Environment=TEXAS_PORT=8765
Environment=TEXAS_AUTO_TRAIN=1
Environment=TEXAS_DATA_DIR=%h/Project/Texas-GTO/artifacts/local
UnsetEnvironment=TEXAS_API_TOKEN TEXAS_ALLOWED_ORIGINS
MemoryAccounting=yes
MemoryMax=1G
Restart=always
RestartSec=3
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
