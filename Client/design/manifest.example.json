{
  "manifest_version": 3,
  "name": "TGTO Research Capture",
  "version": "0.3.0",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://h5.wpk.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开 TGTO 采集"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' ws://127.0.0.1:8765 ws://127.0.0.1:8766"
  }
}
