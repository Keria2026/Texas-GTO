{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true,
    "jsx": "react-jsx", "types": ["chrome", "node"], "skipLibCheck": true
  },
  "include": ["extension", "tests/*.ts", "tools/*.ts"]
}
