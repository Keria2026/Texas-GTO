{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "simulation"
    },
    "hand_complete": {
      "type": "boolean"
    },
    "players": {
      "minItems": 2,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string",
            "minLength": 1
          },
          "seat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "statistics": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "successes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "opportunities": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "posterior_mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "interval": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "interval_method": {
                  "type": "string",
                  "minLength": 1
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "successes",
                "opportunities",
                "posterior_mean",
                "interval",
                "interval_method",
                "model_version"
              ],
              "additionalProperties": false
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "context": {
                  "type": "string",
                  "minLength": 1
                },
                "legal_actions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "counts": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "probabilities": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "observations": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "action_encoding": {
                  "type": "string",
                  "const": "family"
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "context",
                "legal_actions",
                "counts",
                "probabilities",
                "observations",
                "action_encoding",
                "model_version"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "player_id",
          "seat",
          "statistics",
          "actions"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "state_version",
    "model_version",
    "source",
    "hand_complete",
    "players",
    "warnings"
  ],
  "additionalProperties": false
}
