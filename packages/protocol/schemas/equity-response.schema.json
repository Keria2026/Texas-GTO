{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "equity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stderr": {
      "type": "number",
      "minimum": 0
    },
    "samples": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "opponents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "rejected_draws": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "algorithm_version": {
      "type": "string",
      "const": "card-equity-v1"
    }
  },
  "required": [
    "equity",
    "stderr",
    "samples",
    "method",
    "seed",
    "opponents",
    "rejected_draws",
    "algorithm_version"
  ],
  "additionalProperties": false
}
