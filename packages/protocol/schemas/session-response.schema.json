{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "game": {
      "type": "object",
      "properties": {
        "game_id": {
          "type": "string",
          "enum": [
            "kuhn",
            "leduc",
            "holdem"
          ]
        },
        "num_players": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "stack": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "small_blind": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "big_blind": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "button": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "abstraction": {
          "type": "string",
          "enum": [
            "none",
            "suit_canonical"
          ]
        }
      },
      "required": [
        "game_id",
        "num_players",
        "stack",
        "small_blind",
        "big_blind",
        "button",
        "abstraction"
      ],
      "additionalProperties": false
    },
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "legal_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "observation": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "payoffs": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "state_version",
    "game",
    "rules_version",
    "actor",
    "terminal",
    "legal_actions",
    "observation",
    "payoffs"
  ],
  "additionalProperties": false
}
