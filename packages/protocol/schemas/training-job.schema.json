{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "diagnostics": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "blueprint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluation": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "job_id",
    "status",
    "diagnostics",
    "blueprint_id",
    "evaluation",
    "error"
  ],
  "additionalProperties": false
}
