{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "status": {
      "type": "string",
      "const": "ok"
    },
    "service": {
      "type": "string",
      "const": "texas-gto-analysis"
    },
    "version": {
      "type": "string",
      "const": "0.1.0"
    },
    "strategy": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "pluribus_style"
        },
        "status": {
          "type": "string",
          "const": "research_ready"
        },
        "supported_games": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "const": "kuhn"
            },
            {
              "type": "string",
              "const": "leduc"
            },
            {
              "type": "string",
              "const": "holdem"
            },
            {
              "type": "string",
              "const": "mushroom"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "provider",
        "status",
        "supported_games"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "status",
    "service",
    "version",
    "strategy"
  ],
  "additionalProperties": false
}
