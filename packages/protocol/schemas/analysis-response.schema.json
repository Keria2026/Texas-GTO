{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "unsupported"
      ]
    },
    "strategy_source": {
      "type": "string",
      "enum": [
        "blueprint",
        "depth_limited_search",
        "none"
      ]
    },
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "frequency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "action",
          "frequency"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "session_id",
    "state_version",
    "status",
    "strategy_source",
    "rules_version",
    "model_version",
    "actions",
    "warnings",
    "diagnostics"
  ],
  "additionalProperties": false
}
