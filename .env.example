# Exact browser/extension origins; this file is an example, not loaded automatically.
TEXAS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Optional synthetic session/model directory (keep outside version control).
TEXAS_DATA_DIR=artifacts/local
# Defaults to 1: one idle-only, resumable eight-seat research training worker.
# Set to 0 only to disable background training; it does not disable the API.
TEXAS_AUTO_TRAIN=1
# Optional TEXAS_API_TOKEN: set privately; >=24 ASCII characters, no whitespace.
# Leave TEXAS_API_TOKEN unset for automatic token-free local connections.
# Setting it explicitly enables the legacy bearer-token mode, not the default local UI.
